<Window x:Class="LiveTranscriber.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveTranscriber — English → Russian" Height="720" Width="930"
        MinHeight="520" MinWidth="740">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="SemiBold" Text="LiveTranscriber"/>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4A7B61"
                 Text="Playback only · English"/>
    </DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock VerticalAlignment="Center" Text="Engine:" Margin="0,0,8,0"/>
      <ComboBox x:Name="EngineSelect" Width="180" SelectedIndex="0" Margin="0,0,12,0">
        <ComboBoxItem Content="Local (offline)"/>
        <ComboBoxItem Content="Cloud (Azure)"/>
      </ComboBox>
      <Button x:Name="StartButton" Width="80" Content="Start" Click="Start_Click" Margin="0,0,8,0"/>
      <Button x:Name="StopButton" Width="80" Content="Stop" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,0"/>
      <Button Width="80" Content="Copy" Click="Copy_Click" Margin="0,0,8,0"/>
      <Button Width="80" Content="Clear" Click="Clear_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock VerticalAlignment="Center" Text="Capture:" Margin="0,0,8,0"/>
      <ComboBox x:Name="CaptureSelect" Width="175" SelectedIndex="0" Margin="0,0,10,0"
                SelectionChanged="CaptureSelect_SelectionChanged">
        <ComboBoxItem Content="All speaker output"/>
        <ComboBoxItem Content="Selected application"/>
      </ComboBox>
      <ComboBox x:Name="ProcessSelect" Width="340" IsEditable="True" IsEnabled="False"
                DisplayMemberPath="Description" Margin="0,0,8,0"
                ToolTip="Select a window or type a numeric process ID"/>
      <Button x:Name="RefreshButton" Width="80" Content="Refresh" Click="Refresh_Click" IsEnabled="False"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
      <CheckBox x:Name="TranslateToggle" Content="Auto-translate EN → RU"
                VerticalAlignment="Center" IsChecked="False" Margin="0,0,12,0"
                ToolTip="Translation disabled until enabled. Select the Local provider to keep English text offline."/>
      <TextBlock VerticalAlignment="Center" Text="Translator:" Margin="0,0,5,0"/>
      <ComboBox x:Name="TranslationProviderSelect" Width="172" SelectedIndex="0" Margin="0,0,10,0"
                SelectionChanged="TranslationProvider_SelectionChanged"
                ToolTip="ChatGPT plan and Groq require explicit cloud opt-in. Local is private.">
        <ComboBoxItem Content="Local OPUS-MT (offline)"/>
        <ComboBoxItem Content="Groq (cloud)"/>
        <ComboBoxItem Content="ChatGPT plan (Sign in)"/>
      </ComboBox>
      <Button x:Name="TestGroqButton" Content="Test translator" Width="105" Margin="0,0,10,0"
              Click="TestGroq_Click" ToolTip="Translate a fixed example using the selected provider. No interview text is used."/>
      <TextBlock x:Name="TranslationStatus" VerticalAlignment="Center" Foreground="#555555"
                 Text="RU disabled. Local OPUS-MT is the default provider."
                 TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="ChatGptSignInButton" Content="Continue with ChatGPT" Width="165"
              Margin="0,0,8,0" Click="ChatGptSignIn_Click" IsEnabled="False"
              ToolTip="Authorize local LiveTranscriber in your browser to use eligible ChatGPT plan features."/>
      <Button x:Name="ChatGptDisconnectButton" Content="Disconnect" Width="95"
              Margin="0,0,8,0" Click="ChatGptDisconnect_Click" IsEnabled="False"/>
      <TextBlock Text="ChatGPT model:" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <ComboBox x:Name="ChatGptModelSelect" Width="220" DisplayMemberPath="DisplayName"
                Margin="0,0,8,0" IsEnabled="False"/>
      <TextBlock x:Name="ChatGptAccountStatus" VerticalAlignment="Center"
                 Foreground="#555555" Text="Not connected" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"
                 Text="English — live transcription"/>
      <TextBox x:Name="TranscriptBox" Grid.Row="1" FontSize="18" FontFamily="Segoe UI"
               Padding="10" Background="#FFF9FAFB" BorderBrush="#FFCCD2DB" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
      <TextBlock Grid.Row="2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"
                 Text="Русский — перевод завершённых фраз"/>
      <TextBox x:Name="RussianBox" Grid.Row="3" FontSize="18" FontFamily="Segoe UI"
               Padding="10" Background="#FFF6F9F6" BorderBrush="#FFCCD2DB" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               TextWrapping="Wrap" AcceptsReturn="True"/>
    </Grid>
    <StackPanel Grid.Row="6" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="Ready. No microphone is opened." Foreground="#555555"/>
      <TextBlock x:Name="ResourceText" Text="CPU/RAM measurements available after Start."
                 TextWrapping="Wrap" Foreground="#444444"/>
      <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
        <TextBlock x:Name="HealthText" Text="Health: not measured" VerticalAlignment="Center"
                   Foreground="#555555" Margin="0,0,16,0"/>
        <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" Width="125"
                Click="CopyDiagnostics_Click"
                ToolTip="Copies only diagnostic counters, not audio or transcript text."/>
      </StackPanel>
      <TextBlock Foreground="#777777" FontSize="12"
                 Text="App mode captures the chosen PID and descendants. Choose the conferencing app's main window."/>
    </StackPanel>
  </Grid>
</Window>
